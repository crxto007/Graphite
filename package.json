{
  "name": "visual-ide",
  "version": "1.0.0",
  "description": "A local web application that combines a real terminal, a visual node-graph canvas, and a code viewer into one interface, powered by an AI coding assistant.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run kill-ports && concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "nodemon backend/index.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "kill-ports": "fuser -k 3000/tcp && fuser -k 5173/tcp || echo 'No processes found on ports 3000 or 5173'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.0.1",
    "@xyflow/react": "^12.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lucide-react": "^0.263.0",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.0.0",
    "nodemon": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "ws": "^8.14.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.7.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.8"
  }
}
